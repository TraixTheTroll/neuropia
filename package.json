{
  "scripts": {
    "build": "JEKYLL_ENV=production bundle exec jekyll build && purgecss -c purgecss.config.js",
    "check:site": "bundle exec ruby bin/check_site.rb",
    "test:site": "playwright test --config test/site/playwright.config.cjs",
    "lint:prettier": "prettier . --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@shopify/prettier-plugin-liquid": "^1.11.1",
    "prettier": "^3.9.9",
    "purgecss": "8.0.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
