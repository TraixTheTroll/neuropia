<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    {% if page.redirect %}<meta http-equiv="refresh" content="3;url={{ '/' | relative_url }}">{% endif %}
    <title>
      {% unless page.homepage %}{{ page.title | escape }} · {% endunless %}
      Neuropia
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip_html | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" type="image/png" href="{{ '/assets/img/neuropia-logo.png' | relative_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    >
    <link rel="stylesheet" href="{{ '/assets/css/neuropia.css' | relative_url | append: '?v=20261029-5' }}">
    <script src="{{ '/assets/js/neuropia.js' | relative_url | append: '?v=20261029-5' }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <button class="back-to-top" type="button" aria-label="Back to top" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m6 12 6-6 6 6M12 6v13"></path>
      </svg>
    </button>
    <canvas id="canvas" aria-hidden="true"></canvas>
    <div class="content">
      <nav aria-label="Main navigation">
        <a class="logo-text" href="{{ '/' | relative_url }}">NEUROPIA</a>
        <ul>
          {% assign sections = 'About,Research,People,Publications,Contact' | split: ',' %}
          {% for section in sections %}
            {% assign anchor = section | downcase | prepend: '#' %}
            <li>
              <a href="{% if page.homepage %}{{ anchor }}{% else %}{{ anchor | prepend: '/' | relative_url }}{% endif %}">{{ section }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
      {% if page.homepage %}
        <main id="main">{{ content }}</main>
      {% else %}
        <main id="main" class="inner-page">
          <section class="page-panel" aria-labelledby="page-title">
            <h1 id="page-title">{{ page.title | escape }}</h1>
            {{ content }}
          </section>
        </main>
      {% endif %}
      <footer>© Copyright {{ 'now' | date: '%Y' }} Neuropia · Bergen, Norway</footer>
    </div>
  </body>
</html>
