{% assign clinical_pi = site.data.members | where: 'slug', 'christopher-elnan-kvistad' | first %}
<p>
  We’d love to hear from you. Whether you’re interested in collaborating, have a question about our research, or have another enquiry, please contact
  {{ clinical_pi.name | escape }} at <a href="mailto:{{ clinical_pi.email | escape }}">{{ clinical_pi.email | escape }}</a>.
</p>
{% for affiliation in site.data.affiliations %}
  <p>
    <strong>{{ affiliation.name | escape }}</strong><br>
    {{ affiliation.department | escape -}}
    <br>
    {{ affiliation.institution | escape -}}
    <br>
    {{ affiliation.address | escape }}
  </p>
{% endfor %}
